generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum FishingTripStatus {
  ACTIVE
  COMPLETED
}

enum BatchStatus {
  MONITORING
  ACTIVE
  INSPECTION_HOLD
  HANDED_OVER
  CLOSED
}

enum BatchLocationType {
  INTAKE
  COLD_STORAGE
  VEHICLE
  DESTINATION
}

enum SensorStatus {
  AVAILABLE
  ASSIGNED
  OFFLINE
  ERROR
}

enum SensorProvisioningStatus {
  PENDING
  PROVISIONED
}

enum SensorSessionStatus {
  ACTIVE
  COMPLETED
}

enum ResourceOperationalStatus {
  AVAILABLE
  UNAVAILABLE
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  UNAVAILABLE
}

enum DestinationStatus {
  AVAILABLE
  UNAVAILABLE
}

enum OperationalEventType {
  TEMPERATURE_EXCURSION
  TRUCK_DELAY
  STORAGE_CHANGE
  DESTINATION_CHANGE
  INSPECTION_HOLD
  OTHER
}

enum OperationalEventSource {
  SYSTEM
  WEB
  WHATSAPP
  TELEGRAM
}

enum MessagingChannel {
  TELEGRAM
  WHATSAPP
}

enum PlanStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  SUPERSEDED
  DISMISSED
}

enum PlanActionType {
  STORE
  LOAD
  DISPATCH
  RETURN_TO_BASE
  HANDOVER
  INSPECT
  OTHER
}

enum PlanStepStatus {
  UPCOMING
  COMPLETED
  CANCELED
}

model User {
  id            BigInt        @id @default(autoincrement())
  name          String
  email         String        @unique
  phone         String
  passwordHash  String        @map("password_hash")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  approvedPlans     Plan[]             @relation("ApprovedPlans")
  ownedPlans        Plan[]             @relation("OwnedPlans")
  batches           Batch[]
  fishingTrips      FishingTrip[]
  coldStorages      ColdStorage[]
  vehicles          Vehicle[]
  destinations      Destination[]
  sensors           Sensor[]
  operationalEvents OperationalEvent[]
  authSessions      AuthSession[]
  messagingConnections MessagingConnection[]
  messagingLinkTokens  MessagingLinkToken[]
  messagingConversations MessagingConversation[]

  @@map("users")
}

model MessagingConnection {
  id             BigInt           @id @default(autoincrement())
  userId         BigInt           @map("user_id")
  channel        MessagingChannel
  externalChatId String           @map("external_chat_id")
  displayName    String?          @map("display_name")
  connectedAt    DateTime         @default(now()) @map("connected_at") @db.Timestamptz
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@unique([channel, externalChatId])
  @@map("messaging_connections")
}

model MessagingLinkToken {
  tokenHash String           @id @map("token_hash")
  userId    BigInt           @map("user_id")
  channel   MessagingChannel
  expiresAt DateTime         @map("expires_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("messaging_link_tokens")
}

model MessagingConversation {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  channel   MessagingChannel
  state     Json
  expiresAt DateTime         @map("expires_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([expiresAt])
  @@map("messaging_conversations")
}

model MessagingUpdate {
  channel          MessagingChannel
  externalUpdateId String           @map("external_update_id")
  receivedAt       DateTime         @default(now()) @map("received_at") @db.Timestamptz

  @@id([channel, externalUpdateId])
  @@index([receivedAt])
  @@map("messaging_updates")
}

model AuthSession {
  tokenHash String   @id @map("token_hash")
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_sessions")
}

model FishingTrip {
  id         BigInt            @id @default(autoincrement())
  userId     BigInt?           @map("user_id")
  code       String
  vesselName String            @map("vessel_name")
  startedAt  DateTime          @map("started_at") @db.Timestamptz
  endedAt    DateTime?         @map("ended_at") @db.Timestamptz
  status     FishingTripStatus
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches    Batch[]

  @@unique([userId, code])
  @@map("fishing_trips")
}

model Batch {
  id                         BigInt        @id @default(autoincrement())
  userId                     BigInt?       @map("user_id")
  code                       String
  fishingTripId              BigInt?       @map("fishing_trip_id")
  weightKg                   Float         @map("weight_kg")
  grade                      String
  status                     BatchStatus
  receivedAt                 DateTime      @map("received_at") @db.Timestamptz
  handedOverAt               DateTime?     @map("handed_over_at") @db.Timestamptz
  equivalentQualityAgeDays   Float?        @map("equivalent_quality_age_days")
  remainingQualityWindowDays Float?        @map("remaining_quality_window_days")
  qualityEstimateStartedAt   DateTime?     @map("quality_estimate_started_at") @db.Timestamptz
  currentTemperatureC        Float?        @map("current_temperature_c")
  locationType               BatchLocationType @default(INTAKE) @map("location_type")
  currentColdStorageId       BigInt?       @map("current_cold_storage_id")
  currentVehicleId           BigInt?       @map("current_vehicle_id")
  currentDestinationId       BigInt?       @map("current_destination_id")
  locationUpdatedAt          DateTime      @default(now()) @map("location_updated_at") @db.Timestamptz
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                  DateTime?     @map("deleted_at") @db.Timestamptz
  user                       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fishingTrip                FishingTrip?  @relation(fields: [fishingTripId], references: [id])
  currentColdStorage         ColdStorage?  @relation("BatchCurrentStorage", fields: [currentColdStorageId], references: [id])
  currentVehicle             Vehicle?      @relation("BatchCurrentVehicle", fields: [currentVehicleId], references: [id])
  currentDestination         Destination?  @relation("BatchCurrentDestination", fields: [currentDestinationId], references: [id])
  sensorSessions             SensorSession[]
  operationalEvents          OperationalEvent[]
  planSteps                  PlanStep[]
  planBatches                PlanBatch[]

  @@unique([userId, code])
  @@index([userId, status])
  @@map("batches")
}

model Sensor {
  id                 BigInt                   @id @default(autoincrement())
  userId             BigInt?                  @map("user_id")
  code               String
  deviceUid          String                   @unique @map("device_uid")
  status             SensorStatus
  provisioningStatus SensorProvisioningStatus @default(PENDING) @map("provisioning_status")
  lastSeenAt         DateTime?                @map("last_seen_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz
  user               User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           SensorSession[]
  operationalEvents  OperationalEvent[]

  @@unique([userId, code])
  @@map("sensors")
}

model SensorSession {
  id           BigInt              @id @default(autoincrement())
  sensorId     BigInt              @map("sensor_id")
  batchId      BigInt              @map("batch_id")
  startedAt    DateTime            @map("started_at") @db.Timestamptz
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz
  status       SensorSessionStatus
  lastSyncedAt DateTime?           @map("last_synced_at") @db.Timestamptz
  sensor       Sensor              @relation(fields: [sensorId], references: [id])
  batch        Batch               @relation(fields: [batchId], references: [id])
  readings     TemperatureReading[]

  @@index([sensorId, status])
  @@map("sensor_sessions")
}

model TemperatureReading {
  id              BigInt        @id @default(autoincrement())
  sensorSessionId BigInt        @map("sensor_session_id")
  sequenceNumber  BigInt        @map("sequence_number")
  temperatureC    Float         @map("temperature_c")
  measuredAt      DateTime      @map("measured_at") @db.Timestamptz
  receivedAt      DateTime      @map("received_at") @db.Timestamptz
  readingUid      String        @unique @map("reading_uid")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  sensorSession   SensorSession @relation(fields: [sensorSessionId], references: [id])

  @@unique([sensorSessionId, sequenceNumber])
  @@index([sensorSessionId, measuredAt])
  @@map("temperature_readings")
}

model ColdStorage {
  id                  BigInt             @id @default(autoincrement())
  userId              BigInt?            @map("user_id")
  name                String
  capacityKg          Float              @map("capacity_kg")
  availableCapacityKg Float              @map("available_capacity_kg")
  operationalStatus   ResourceOperationalStatus @map("operational_status")
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationalEvents   OperationalEvent[]
  planSteps           PlanStep[]
  currentBatches      Batch[]            @relation("BatchCurrentStorage")

  @@unique([userId, name])
  @@map("cold_storages")
}

model Vehicle {
  id                BigInt             @id @default(autoincrement())
  userId            BigInt?            @map("user_id")
  code              String
  capacityKg        Float              @map("capacity_kg")
  operationalStatus ResourceOperationalStatus @map("operational_status")
  delayMinutes      Int                @default(0) @map("delay_minutes")
  delayPersistent   Boolean            @default(false) @map("delay_persistent")
  restriction       String?
  availabilityStart DateTime?          @map("availability_start") @db.Time
  availabilityEnd   DateTime?          @map("availability_end") @db.Time
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationalEvents OperationalEvent[]
  planSteps         PlanStep[]
  currentBatches    Batch[]            @relation("BatchCurrentVehicle")

  @@unique([userId, code])
  @@map("vehicles")
}

model Destination {
  id                BigInt             @id @default(autoincrement())
  userId            BigInt?            @map("user_id")
  name              String
  address           String
  travelMinutes     Int                @map("travel_minutes")
  receivingStart    DateTime           @map("receiving_start") @db.Time
  receivingEnd      DateTime           @map("receiving_end") @db.Time
  status            DestinationStatus
  notes             String?
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationalEvents OperationalEvent[]
  planSteps         PlanStep[]
  plans             Plan[]             @relation("PlanDestination")
  currentBatches    Batch[]             @relation("BatchCurrentDestination")

  @@unique([userId, name])
  @@map("destinations")
}

model OperationalEvent {
  id             BigInt                 @id @default(autoincrement())
  userId         BigInt?                @map("user_id")
  type           OperationalEventType
  source         OperationalEventSource
  batchId        BigInt?                @map("batch_id")
  vehicleId      BigInt?                @map("vehicle_id")
  coldStorageId  BigInt?                @map("cold_storage_id")
  destinationId  BigInt?                @map("destination_id")
  sensorId       BigInt?                @map("sensor_id")
  rawMessage     String?                @map("raw_message")
  dedupeKey      String?                @unique @map("dedupe_key")
  structuredData Json                   @default("{}") @map("structured_data")
  occurredAt     DateTime               @map("occurred_at") @db.Timestamptz
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch          Batch?                 @relation(fields: [batchId], references: [id])
  vehicle        Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  coldStorage    ColdStorage?           @relation(fields: [coldStorageId], references: [id], onDelete: Restrict)
  destination    Destination?           @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  sensor         Sensor?                @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  triggeredPlans Plan[]

  @@index([userId, occurredAt])
  @@map("operational_events")
}

model Plan {
  id             BigInt            @id @default(autoincrement())
  userId         BigInt?           @map("user_id")
  version        Int
  status         PlanStatus
  previousPlanId BigInt?           @map("previous_plan_id")
  triggerEventId BigInt?           @map("trigger_event_id")
  destinationId  BigInt?           @map("destination_id")
  summary        String
  deadline       DateTime?         @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  approvedAt     DateTime?         @map("approved_at") @db.Timestamptz
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz
  approvedById   BigInt?           @map("approved_by")
  previousPlan   Plan?             @relation("PlanVersions", fields: [previousPlanId], references: [id])
  revisions      Plan[]            @relation("PlanVersions")
  triggerEvent   OperationalEvent? @relation(fields: [triggerEventId], references: [id])
  destination    Destination?      @relation("PlanDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  user           User?             @relation("OwnedPlans", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy     User?             @relation("ApprovedPlans", fields: [approvedById], references: [id])
  steps          PlanStep[]
  batches        PlanBatch[]

  @@unique([userId, version])
  @@index([userId, status, createdAt])
  @@index([previousPlanId, status])
  @@index([destinationId])
  @@map("plans")
}

model PlanBatch {
  planId  BigInt @map("plan_id")
  batchId BigInt @map("batch_id")
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([planId, batchId])
  @@index([batchId])
  @@map("plan_batches")
}

model PlanStep {
  id            BigInt         @id @default(autoincrement())
  planId        BigInt         @map("plan_id")
  sequence      Int
  actionType    PlanActionType @map("action_type")
  batchId       BigInt?        @map("batch_id")
  coldStorageId BigInt?        @map("cold_storage_id")
  vehicleId     BigInt?        @map("vehicle_id")
  destinationId BigInt?        @map("destination_id")
  scheduledAt   DateTime       @map("scheduled_at") @db.Timestamptz
  status        PlanStepStatus
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz
  rationale     String?
  timingRationale String?      @map("timing_rationale")
  latestSafeAt  DateTime?      @map("latest_safe_at") @db.Timestamptz
  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  batch         Batch?         @relation(fields: [batchId], references: [id])
  coldStorage   ColdStorage?   @relation(fields: [coldStorageId], references: [id], onDelete: Restrict)
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  destination   Destination?   @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([planId, sequence])
  @@index([planId, status])
  @@index([vehicleId, status])
  @@map("plan_steps")
}
